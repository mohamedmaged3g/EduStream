rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mohamedmaged3g@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isInstructor() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'instructor')
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      // Allow user creation or super admin updates/role upgrades
      allow create: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])))
      );
      allow delete: if isSuperAdmin();
    }

    // Courses Collection
    match /courses/{courseId} {
      allow read: if true;
      allow create: if isInstructor() || isSuperAdmin();
      allow update: if isInstructor() || isSuperAdmin();
      allow delete: if isInstructor() || isSuperAdmin();
    }

    // Role Requests for Student to Instructor promotion
    match /role_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
  }
}
