{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role management and tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "avatar": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "instructor", "admin"] },
        "requestedRole": { "type": "string", "enum": ["instructor", "none"] },
        "xp": { "type": "number" },
        "streakDays": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Course": {
      "title": "Course",
      "description": "Training course created by instructors",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "category": { "type": "string" },
        "categoryNameAr": { "type": "string" },
        "level": { "type": "string" },
        "price": { "type": "number" },
        "instructorId": { "type": "string" },
        "instructorName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "instructorId"]
    },
    "RoleRequest": {
      "title": "RoleRequest",
      "description": "Student upgrade request to instructor role pending admin approval",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "requestedRole": { "type": "string", "enum": ["instructor"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reason": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "userEmail", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles with roles: admin, instructor, student"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Educational courses with lessons, videos, and PDFs"
    },
    "/role_requests/{requestId}": {
      "schema": "RoleRequest",
      "description": "Requests from students wishing to become instructors, reviewable by admin"
    }
  }
}
